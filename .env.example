# Local Node.js + PostgreSQL development
DATABASE_URL=postgres://galgame:galgame_password@localhost:5432/galgame
DATABASE_POOL_SIZE=10
UPLOAD_DIR=./uploads

# Required application settings
BETTER_AUTH_SECRET=replace-this-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3004
ADMIN_EMAILS=

# Optional email integration. Blank values use the development console transport.
RESEND_API_KEY=
EMAIL_FROM=FlareStarter <onboarding@resend.dev>
RESEND_AUDIENCE_ID=

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=

# Optional bot protection and observability
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ANALYTICS_TOKEN=
SENTRY_DSN=
