{
  "name": "flarestarter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev --port 3004",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/serve.mjs",
    "preview": "pnpm build && node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview --port 3004",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:legacy-workers": "vitest run --project workers",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "pnpm db:migrate"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@gsap/react": "^2.1.2",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/cloudflare": "^10.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "fumadocs-core": "^16.10.6",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.10.6",
    "gsap": "^3.15.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "postgres": "^3.4.7",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.95.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
