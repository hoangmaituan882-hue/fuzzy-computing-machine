APP_PORT=3000
POSTGRES_PASSWORD=change_this_postgres_password

# 必填：至少 32 个字符。可以用 `openssl rand -base64 32` 生成。
BETTER_AUTH_SECRET=change_this_to_a_32_char_or_longer_secret

# 必填：你的公网访问地址。部署到正式域名时保持下面这个值。
BETTER_AUTH_URL=https://www.linzesss.icu

# 必填：登录后自动成为后台管理员的邮箱，多个用英文逗号分隔。
ADMIN_EMAILS=admin@linzesss.icu

# 可选：不填则邮件功能降级为控制台输出。
RESEND_API_KEY=
EMAIL_FROM=
RESEND_AUDIENCE_ID=

# 可选：社交登录。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 可选：计费/赞助。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=

# 可选：验证码/统计/错误上报。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ANALYTICS_TOKEN=
SENTRY_DSN=
